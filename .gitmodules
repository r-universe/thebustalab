[submodule ".registry"]
	path = .registry
	url = https://github.com/thebustalab/thebustalab.r-universe.dev
	branch = HEAD
[submodule "bustalab"]
	path = bustalab
	url = https://github.com/thebustalab/phylochemistry
	subdir = bustalab
[submodule "phylochemistry"]
	path = phylochemistry
	url = https://github.com/thebustalab/phylochemistry
	subdir = phylochemistry
